# name: test/sql/marc_dedupe.test
# description: fuzzy deduplication (marc_dedupe_key, marc_dedupe_candidates)
# group: [marc]

require marc21

statement ok
SET VARIABLE utf8 = 'test/data/sample_utf8.mrc';

# marc_dedupe_key is marc_matchkey: NACO 245 $a $b || ISBN || year (record 1
# has an invalid-checksum 020 and no 260/264, so both tail parts are empty).
query II
SELECT marc_dedupe_key(fields),
       marc_dedupe_key(fields) = marc_matchkey(fields)
FROM read_marc(getvariable('utf8')) WHERE record_no = 1;
----
LODZ AND THE RIVER A STUDY||	true

# Threshold 0.0: every unordered pair of the 3-record file, each exactly once,
# similarity in [0, 1], no shared match keys (all titles distinct).
query IIIII
SELECT record_no_a, record_no_b, title_a,
       similarity >= 0 AND similarity <= 1,
       same_matchkey
FROM marc_dedupe_candidates(getvariable('utf8'), 0.0)
ORDER BY record_no_a, record_no_b;
----
1	2	Łódź and the river :	true	false
1	3	Łódź and the river :	true	false
2	3	日本の歴史 /	true	false

# Similarity ordering: disjoint scripts (Latin vs CJK) score exactly 0, while
# the two Latin titles share letters and score strictly higher (yet below 1).
query III
SELECT (SELECT similarity FROM marc_dedupe_candidates(getvariable('utf8'), 0.0)
        WHERE record_no_a = 1 AND record_no_b = 2) = 0,
       (SELECT similarity FROM marc_dedupe_candidates(getvariable('utf8'), 0.0)
        WHERE record_no_a = 1 AND record_no_b = 3) > 0,
       (SELECT similarity FROM marc_dedupe_candidates(getvariable('utf8'), 0.0)
        WHERE record_no_a = 1 AND record_no_b = 3) < 1;
----
true	true	true

# A strict threshold filters every pair: distinct titles, distinct keys.
query I
SELECT count(*) FROM marc_dedupe_candidates(getvariable('utf8'), 0.7);
----
0

# Build a file containing a true duplicate of record 1, then verify the
# exact-matchkey rule: with a threshold no similarity can reach (> 1), the
# duplicate pair is still reported.
statement ok
COPY (SELECT leader, fields FROM read_marc(getvariable('utf8'))
      UNION ALL
      SELECT leader, fields FROM read_marc(getvariable('utf8')) WHERE record_no = 1)
TO '__TEST_DIR__/dup.mrc' (FORMAT marc);

query I
SELECT count(*) FROM read_marc('__TEST_DIR__/dup.mrc');
----
4

query IIII
SELECT count(*), bool_and(same_matchkey), bool_and(title_a = title_b),
       bool_and(similarity = 1.0)
FROM marc_dedupe_candidates('__TEST_DIR__/dup.mrc', 1.01);
----
1	true	true	true
