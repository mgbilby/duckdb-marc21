# name: test/sql/marc_reports.test
# description: QA report table macros (tags, subfields, completeness, errors)
# group: [marc]

require marc21

statement ok
SET VARIABLE utf8 = 'test/data/sample_utf8.mrc';

# Tag frequency over the 3-record fixture (records 001 and 245 appear in all
# three records; the three 650s all sit in record 1).
query IIII
SELECT tag, "count", records_with, pct_records = 100.0
FROM marc_report_tags(getvariable('utf8')) ORDER BY tag;
----
001	3	3	true
003	1	1	false
008	1	1	false
020	1	1	false
100	1	1	false
245	3	3	true
650	3	1	false
856	1	1	false
880	1	1	false

# Subfield frequency inside 650: record 1 has $a x3, $z x3, $2 x1, $0 x1.
query III
SELECT code, "count", records_with
FROM marc_report_subfields(getvariable('utf8'), '650') ORDER BY code;
----
0	1	1
2	1	1
a	3	1
z	3	1

# Completeness: record 1 scores title 30 + author 15 + subject 15 + isbn 10 +
# language 10 = 80; records 2 and 3 have only a title (30).
query IIIIIII
SELECT control_number, has_title, has_author, has_subject, has_isbn,
       has_language, completeness
FROM marc_report_completeness(getvariable('utf8')) ORDER BY record_no;
----
ocm00000001	true	true	true	true	true	80
ocm00000002	true	false	false	false	false	30
ocm00000003	true	false	false	false	false	30

# The publication/physical flags are false throughout the fixture.
query I
SELECT count(*) FROM marc_report_completeness(getvariable('utf8'))
WHERE has_publication OR has_physical;
----
0

# All fixture records pass structural validation -> no error rows.
query I
SELECT count(*) FROM marc_report_errors(getvariable('utf8'));
----
0
