# name: test/sql/marc_folio.test
# description: FOLIO data-import checks and bib-to-instance mapping
# group: [marc]

require marc21

statement ok
SET VARIABLE utf8 = 'test/data/sample_utf8.mrc';

# Record 1 has 001+003 and a UTF-8 leader; records 2 and 3 have 001 without 003.
query II
SELECT record_no, len(marc_folio_check(leader, fields))
FROM read_marc(getvariable('utf8')) ORDER BY record_no;
----
1	0
2	1
3	1

query I
SELECT marc_folio_check(leader, fields)[1]
FROM read_marc(getvariable('utf8')) WHERE record_no = 2;
----
001 without 003: FOLIO qualifies the 001 control number by the 003 source

# A MARC-8 record carrying a 999 ff and no 001 trips three checks.
query III
SELECT v[1], v[2], v[3] FROM (SELECT marc_folio_check('00000nam  2200000   4500', [
    struct_pack(tag := '999', ind1 := 'f', ind2 := 'f', value := NULL::VARCHAR,
                subfields := [struct_pack(code := 'i', value := 'some-uuid')])]) AS v);
----
no 001: FOLIO data import uses 001 as the incoming record identifier	999 ff present: FOLIO reserves 999 ff for its own instance/SRS identifiers	leader/09 is not 'a': FOLIO expects UTF-8 encoded records

# marc_instance: title 245$a$b$c with ISBD trailing punctuation trimmed.
query I
SELECT struct_extract(marc_instance(leader, fields), 'title')
FROM read_marc(getvariable('utf8')) WHERE record_no = 1;
----
Łódź and the river : a study / Anna Müller

# Contributors (1XX/7XX $a), languages (008/35-37 + 041$a), subjects (6XX $a).
query IIIII
SELECT len(struct_extract(i, 'contributors')),
       struct_extract(i, 'contributors')[1],
       struct_extract(i, 'languages')[1],
       len(struct_extract(i, 'subjects')),
       struct_extract(i, 'subjects')[2]
FROM (SELECT marc_instance(leader, fields) AS i
      FROM read_marc(getvariable('utf8')) WHERE record_no = 1);
----
1	Müller, Anna	eng	3	Cities and towns

# Identifiers: 020$a becomes a typed isbn entry.
query III
SELECT len(ids), struct_extract(ids[1], 'type'), struct_extract(ids[1], 'value')
FROM (SELECT struct_extract(marc_instance(leader, fields), 'identifiers') AS ids
      FROM read_marc(getvariable('utf8')) WHERE record_no = 1);
----
1	isbn	9780000000001

# Absent pieces come back NULL / empty rather than erroring.
query IIII
SELECT struct_extract(struct_extract(i, 'publication'), 'place') IS NULL,
       struct_extract(i, 'edition') IS NULL,
       len(struct_extract(i, 'contributors')),
       len(struct_extract(i, 'languages'))
FROM (SELECT marc_instance(leader, fields) AS i
      FROM read_marc(getvariable('utf8')) WHERE record_no = 2);
----
true	true	0	0

query I
SELECT struct_extract(marc_instance(leader, fields), 'title')
FROM read_marc(getvariable('utf8')) WHERE record_no = 2;
----
日本の歴史 / 山田太郎
