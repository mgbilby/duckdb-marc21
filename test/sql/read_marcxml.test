# name: test/sql/read_marcxml.test
# description: MARCXML (slim schema) reader
# group: [marc]

require marc21

statement ok
SET VARIABLE xml = 'test/data/sample.xml';

# Same records as sample_utf8.mrc: 3 records, 27 subfield rows
query II
SELECT count(DISTINCT record_no), count(*) FROM read_marcxml(getvariable('xml'));
----
3	27

query I
SELECT control_number FROM read_marcxml(getvariable('xml'))
GROUP BY control_number ORDER BY control_number;
----
ocm00000001
ocm00000002
ocm00000003

# Nested macro layered on top
query I
SELECT marc_subfield(fields, '245', 'a')
FROM marc_readnestedxml(getvariable('xml')) ORDER BY record_no;
----
Łódź and the river :
日本の歴史 /
The empty record.

query I
SELECT count(*) FROM read_marcxml(getvariable('xml'), tags := '650,880');
----
10
